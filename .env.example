# Copy to .env and adjust. .env is git-ignored.

# Web server
HOST=127.0.0.1          # use 0.0.0.0 to serve other machines on the hospital LAN
PORT=8080

# MQTT broker (unchanged default from the original project)
MQTT_URL=ws://localhost:9001/mqtt
# MQTT_USERNAME=
# MQTT_PASSWORD=

# SQLite database file
DB_PATH=data/wardos.db
READING_RETENTION_DAYS=30

# Sessions
STAFF_SESSION_HOURS=12
PATIENT_SESSION_HOURS=24
# SECURE_COOKIES=1      # set when served over HTTPS

# Demo only - never in production
# WARDOS_DEMO=1           # load server/seed/demo_seed.json into an empty database
# PATIENT_NAME_LOGIN=1    # allow name-only patient sign-in (ignored when NODE_ENV=production)
